# Secrets / local env
.env
*.env
!.env.example

# TLS material for local https. The private key in here is a real private key;
# committing it would publish it. Regenerate with:
#   python backend/scripts/generate_dev_cert.py
backend/certs/
*.pem
*.key
*.pfx
*.p12

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Node / Expo
node_modules/
.expo/
dist/
web-build/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Claude Code local state
.claude/scheduled_tasks.lock

# MCP server config. Points at an absolute path to a per-machine virtualenv,
# so it is local setup rather than something a teammate could use.
.mcp.json

# Never commit real user/health data
**/real-data/
**/*real-patient*

# Local index cache written by the token-savior MCP server.
.token-savior-cache.json

# Cached MedlinePlus responses for the retrieval-accuracy harness. Several
# hundred KB of someone else's data, regenerated by re-running the script:
#   python backend/scripts/topic_retrieval_eval/measure.py
backend/scripts/topic_retrieval_eval/upstream_cache.json

# Tesseract's English model, downloaded at runtime by tesseract.js. 5 MB of
# generated data, not source - the web scanner fetches it from a CDN.
mobile/eng.traineddata
