# Copy to .env for local development. Never commit a real .env file.

# Synthetic/local-only database — do not point this at a database containing
# real user data. Outside a development ENVIRONMENT the app appends
# sslmode=require to a Postgres URL that does not already specify TLS.
DATABASE_URL=postgresql://medhelp:medhelp@localhost:5432/medhelp_dev

# ⛔ SIGNING KEY. This is the whole of the app's authentication: every
# per-user filter in app/api trusts a token signed with it. There is
# deliberately NO usable default here any more — the old placeholder was
# published in this file, so anyone who had read the repository could mint a
# token for any account.
#
# Generate one now:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# The app REFUSES TO START with a missing, short (<32 char) or placeholder
# secret unless ENVIRONMENT is one of: local, dev, development, test, testing.
# In those, it generates a random one per process and warns — so sessions do
# not survive a restart, and no copy of this app anywhere trusts a key that
# appears in source control.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# The signing algorithm is fixed at HS256 in app/core/config.py and is
# deliberately NOT configurable — an algorithm an attacker can influence is
# how token forgery starts.

# Browser origins allowed to call this API, comma-separated. "*" is refused
# outside a development ENVIRONMENT. In development, any loopback/LAN/mesh
# origin is also accepted (CORS_ALLOW_PRIVATE_ORIGINS), so serving the web
# build at http://192.168.1.5:8081 needs no change here.
CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
CORS_ALLOW_PRIVATE_ORIGINS=true

# Serve /docs, /redoc and /openapi.json. Ignored (forced off) outside a
# development ENVIRONMENT.
ENABLE_API_DOCS=true

# Largest request body read, in bytes.
MAX_REQUEST_BODY_BYTES=262144

# Failed sign-in / sign-up attempts allowed per client address per window.
# See app/core/rate_limit.py for what this does and does not cover.
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Required for the symptom-intake triage classifier. Without it the intake
# endpoint reports itself unavailable rather than guessing a tier.
ANTHROPIC_API_KEY=

# Attaches MedlinePlus reading material to intake results. OFF pending
# clinician review of how topics are chosen — see CLAUDE.md. While false, no
# symptom text is sent to NLM at all.
MEDLINEPLUS_TOPICS_ENABLED=false

# One of: local, dev, development, test, testing (development behaviour), or
# anything else (production behaviour: strict secret, strict CORS, no docs,
# TLS required to Postgres).
ENVIRONMENT=local
