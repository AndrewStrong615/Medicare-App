# Copy to .env for local development. Never commit a real .env file.

# Synthetic/local-only database — do not point this at a database containing
# real user data. Outside a development ENVIRONMENT the app appends
# sslmode=require to a Postgres URL that does not already specify TLS.
DATABASE_URL=postgresql://medhelp:medhelp@localhost:5432/medhelp_dev

# ⛔ SIGNING KEY. This is the whole of the app's authentication: every
# per-user filter in app/api trusts a token signed with it. There is
# deliberately NO usable default here any more — the old placeholder was
# published in this file, so anyone who had read the repository could mint a
# token for any account.
#
# Generate one now:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# The app REFUSES TO START with a missing, short (<32 char) or placeholder
# secret unless ENVIRONMENT is one of: local, dev, development, test, testing.
# In those, it generates a random one per process and warns — so sessions do
# not survive a restart, and no copy of this app anywhere trusts a key that
# appears in source control.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# The signing algorithm is fixed at HS256 in app/core/config.py and is
# deliberately NOT configurable — an algorithm an attacker can influence is
# how token forgery starts.

# Browser origins allowed to call this API, comma-separated. "*" is refused
# outside a development ENVIRONMENT. In development, any loopback/LAN/mesh
# origin is also accepted (CORS_ALLOW_PRIVATE_ORIGINS), so serving the web
# build at http://192.168.1.5:8081 needs no change here.
CORS_ALLOW_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
CORS_ALLOW_PRIVATE_ORIGINS=true

# Serve /docs, /redoc and /openapi.json. Ignored (forced off) outside a
# development ENVIRONMENT.
ENABLE_API_DOCS=true

# Largest request body read, in bytes.
MAX_REQUEST_BODY_BYTES=262144

# Failed sign-in / sign-up attempts allowed per client address per window.
# See app/core/rate_limit.py for what this does and does not cover.
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# ---------------------------------------------------------------------------
# The model layer for symptom intake. BOTH options are optional: the
# deterministic rule layer always runs and is the product. With neither set,
# intake still works — it just runs on rules alone.
# ---------------------------------------------------------------------------

# Option A (free): any OpenAI-compatible chat endpoint. Setting a base URL and
# a model switches intake to the agentic deduction loop, which drives the
# model through the app's own red-flag and rule screens instead of asking it
# for a tier in one shot. See docs/free-model-setup.md.
#
# ⛔ THE BASE URL IS A DATA-HANDLING DECISION, NOT A PREFERENCE. A symptom
# description is the most sensitive free text in this app and this project has
# a signed BAA with nobody.
#
#   Local — nothing leaves this machine, no BAA question arises:
#     LLM_BASE_URL=http://localhost:11434/v1     (Ollama; LLM_API_KEY empty)
#
#   Hosted free tiers — these TRANSMIT HEALTH DATA to a third party:
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#
# The app logs a warning naming the exposure whenever the endpoint is not
# local. Synthetic data only until that question has an answer.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# Health goals may use a DIFFERENT endpoint from symptom triage.
#
# The settings above are shared by every model caller, so pointing them at a
# hosted provider to get goal suggestions also sends symptom descriptions
# there — the most sensitive text in this app, and the feature with the
# standing clinical and legal release blocker.
#
# Each of these falls back to its LLM_* counterpart when empty, so leaving all
# three blank is exactly the behaviour of not having them. Setting them moves
# goals and only goals. Example — goals on Groq, symptoms staying local:
#
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:3b
#   GOALS_LLM_BASE_URL=https://api.groq.com/openai/v1
#   GOALS_LLM_MODEL=llama-3.3-70b-versatile
#   GOALS_LLM_API_KEY=gsk_...
#
# ⛔ A hosted goals endpoint still transmits goal text, which is health free
# text about an identified user, to a vendor this project has no BAA with.
GOALS_LLM_BASE_URL=
GOALS_LLM_MODEL=
GOALS_LLM_API_KEY=

# Option B (paid): the original one-shot Anthropic layer. Used only when no
# LLM_BASE_URL is set. There is no free tier for this API.
ANTHROPIC_API_KEY=

# Attaches MedlinePlus reading material to intake results. OFF pending
# clinician review of how topics are chosen — see CLAUDE.md. While false, no
# symptom text is sent to NLM at all.
MEDLINEPLUS_TOPICS_ENABLED=false

# One of: local, dev, development, test, testing (development behaviour), or
# anything else (production behaviour: strict secret, strict CORS, no docs,
# TLS required to Postgres).
ENVIRONMENT=local
